{
  "name": "xvault",
  "version": "21.0.0",
  "private": true,
  "description": "Local-first X/Twitter archive and media manager (Chrome and Edge MV3 extension; experimental Firefox build).",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"tests/**/*.test.*\"",
    "check": "node scripts/check-extension.mjs",
    "build": "node scripts/build.mjs",
    "build:all": "node scripts/build.mjs --target=all",
    "vendor:ocr": "node scripts/vendor-ocr.mjs",
    "postinstall": "node scripts/vendor-ocr.mjs",
    "e2e": "node scripts/e2e-extension.mjs && node scripts/e2e-library.mjs",
    "e2e:a11y": "node scripts/e2e-a11y.mjs",
    "bench": "node scripts/bench.mjs",
    "verify": "npm run check && npm run lint && npm test && npm run format:check"
  },
  "devDependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.0",
    "fake-indexeddb": "^6.2.7",
    "globals": "^15.15.0",
    "prettier": "^3.6.0",
    "tesseract.js": "^7.0.0",
    "tesseract.js-core": "^7.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
